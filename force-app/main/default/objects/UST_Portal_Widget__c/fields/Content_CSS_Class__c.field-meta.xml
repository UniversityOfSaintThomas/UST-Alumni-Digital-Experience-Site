<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Content_CSS_Class__c</fullName>
    <description>CSS class applied to the wrapper around the Static Content widget. Each value must have a matching rule in ustStaticContent.css. Leave blank for the default look. To add a style: add a picklist value here (API name = CSS class) AND a rule in ustStaticContent.css.</description>
    <externalId>false</externalId>
    <inlineHelpText>Optional style applied to this whole widget. Leave blank for the default look.</inlineHelpText>
    <label>Content CSS Class</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>ust-content-callout</fullName>
                <default>false</default>
                <label>Callout Panel</label>
            </value>
            <value>
                <fullName>ust-content-inverse</fullName>
                <default>false</default>
                <label>Purple Banner (light text)</label>
            </value>
            <value>
                <fullName>ust-content-centered</fullName>
                <default>false</default>
                <label>Centered Text</label>
            </value>
            <value>
                <fullName>ust-content-muted</fullName>
                <default>false</default>
                <label>Muted / Small Print</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
