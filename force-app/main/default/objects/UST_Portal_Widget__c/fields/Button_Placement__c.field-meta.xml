<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Button_Placement__c</fullName>
    <description>Whether the widget&apos;s call-to-action buttons appear above or below the text. Defaults to Below.</description>
    <inlineHelpText>Show the buttons above or below the text.</inlineHelpText>
    <label>Button Placement</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Below</fullName>
                <default>true</default>
                <label>Below the text</label>
            </value>
            <value>
                <fullName>Above</fullName>
                <default>false</default>
                <label>Above the text</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
