<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Alumni Directory</description>
    <isExposed>true</isExposed>
    <masterLabel>Alumni Directory</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="useNewProfileLink" type="Boolean" default="false"
                       label="Use New Alumni Profile Page"
                       description="Off (default): clicking an alum opens the old standard record detail page - required on the legacy Aura-template site. On: routes to the new Alumni Profile page instead." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>