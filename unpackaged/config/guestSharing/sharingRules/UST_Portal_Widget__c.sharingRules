<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>ShareActiveWidgetsWithAlumniGuest</fullName>
        <accessLevel>Read</accessLevel>
        <description>Lets the Alumni site guest user read active portal widgets directly, for example the pictures a Hero Banner points at. Guests still only get the fields granted in the Alumni_Community_Guest permission set.</description>
        <label>Share Active Widgets With Alumni Guest</label>
        <sharedTo>
            <guestUser>Alumni</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>Is_Active__c</field>
            <operation>equals</operation>
            <value>true</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
